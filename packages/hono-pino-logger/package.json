{
  "name": "@commercelayer/hono-pino-logger",
  "version": "2.8.0",
  "description": "Pino logger middleware for Hono with request/response logging",
  "copyright": "©2026 Commerce Layer Inc.",
  "author": {
    "name": "Commerce Layer",
    "email": "development@commercelayer.io"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=7"
  },
  "keywords": [
    "commercelayer",
    "hono",
    "pino",
    "logger",
    "logging",
    "middleware",
    "http",
    "request",
    "response"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/common-utils.git",
    "directory": "packages/hono-pino-logger"
  },
  "bugs": {
    "url": "https://github.com/commercelayer/common-utils/issues"
  },
  "homepage": "https://github.com/commercelayer/common-utils/tree/main/packages/hono-pino-logger#readme",
  "scripts": {
    "lint": "pnpm biome check src",
    "lint:fix": "pnpm biome check src --write",
    "test": "pnpm run lint && vitest run --silent",
    "test:verbose": "pnpm run lint && vitest run --silent=false",
    "build": "tsup",
    "jsr:publish": "pnpx jsr publish"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.6.1",
    "hono": "^4.13.8",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.0.0 || ^2.0.0",
    "hono": "^4.0.0"
  }
}
